{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature verify",
  "type": "object",
  "properties": {
    "ok": { "type": "boolean" },
    "inScope": { "type": "boolean" },
    "changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outOfScope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "passed": { "type": "boolean" },
        "exitCode": { "type": "integer" },
        "tail": { "type": "string" },
        "where": { "type": "string", "enum": ["sandbox", "host"] },
        "setup": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["environment-missing", "slot-busy", "sandbox-error"]
                },
                "message": { "type": "string" },
                "proposal": { "type": ["object", "null"] }
              },
              "required": ["status", "message", "proposal"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["command", "passed", "exitCode", "tail", "where", "setup"]
    }
  },
  "required": ["ok", "inScope", "changed", "outOfScope", "test"]
}
