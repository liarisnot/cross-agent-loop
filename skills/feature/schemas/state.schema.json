{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature state",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "lastReconcile": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["pending", "preflight", "running", "in-review", "merged", "failed"]
          },
          "failures": { "type": "integer", "minimum": 0 },
          "sessionId": { "type": ["string", "null"] },
          "resultFile": { "type": ["string", "null"] },
          "worktree": { "type": ["string", "null"] },
          "baseSha": { "type": ["string", "null"] },
          "verify": { "type": ["object", "null"] }
        },
        "required": ["status", "failures"]
      }
    }
  },
  "required": ["name", "tasks"]
}
